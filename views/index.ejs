<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard | SecureVault</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
      <h1 class="dashboard-title">My Vault</h1>
      <a href="/logout" class="btn btn-danger">Sign Out</a>
    </div>

    <!-- Plan Status -->
    <% if (role === "free") { %>
      <div class="plan-badge">
        ⚡ Free Plan: <%= passwords.length %>/5 passwords used
      </div>
    <% } %>

    <a href="/plans" class="btn btn-sm btn-plan">Plans</a>


    <!-- Add Password Form -->
    <div class="add-password-card">
      <h3>Add New Password</h3>
      <form method="POST" action="/add">
        <div class="form-grid">
          <input name="service" placeholder="Service (e.g., Gmail, Netflix)" class="form-input" required />
          <input name="username" placeholder="Username or Email" class="form-input" required />
          <input name="password" type="password" placeholder="Password" class="form-input" required />
        </div>
        <button type="submit" class="btn btn-primary btn-full">Save Password Securely</button>
      </form>
    </div>

    <!-- Password List -->
    <div class="passwords-section">
      <h3 style="margin-bottom:1.5rem;font-size:1.25rem;font-weight:600;">
        Saved Passwords (<%= passwords.length %>)
      </h3>

      <% if (passwords.length === 0) { %>
        <div class="empty-state">
          <p>No passwords saved yet.</p>
          <p style="font-size:.875rem;margin-top:.5rem;">Add your first password above to get started.</p>
        </div>
      <% } else { %>
        <div class="passwords-grid">
          <% passwords.forEach(function(pw){ %>
            <div class="password-card" data-id="<%= pw.id %>">
              <h4><%= pw.service %></h4>
              <p><strong>Username:</strong> <%= pw.username %></p>

              <!-- Hidden details -->
              <div id="details-<%= pw.id %>" class="password-details" style="margin-top:1rem;">
                <div style="display:flex;align-items:center;gap:.5rem;">
                  <strong>Password:</strong>
                  <!-- store the real password URL-encoded to avoid quote issues -->
                  <span id="pw-<%= pw.id %>" class="pw" data-actual="<%= encodeURIComponent(pw.password) %>">••••••••</span>
                  <button type="button" class="btn btn-sm btn-outline-secondary reveal-btn" data-id="<%= pw.id %>">👁</button>
                </div>
              </div>

              <!-- Actions -->
              <div class="password-actions" style="margin-top:1rem;display:flex;gap:.5rem;">
                <a href="/edit/<%= pw.id %>" class="btn btn-sm btn-warning">Edit</a>
                <form method="POST" action="/delete/<%= pw.id %>" onsubmit="return confirm('Are you sure you want to delete this password?')">
                  <button class="btn btn-sm btn-danger">Delete</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- JS: event delegation; no inline handlers -->
  <script>
    // Expand/collapse when clicking anywhere on the card,
    // but ignore clicks on buttons/links/forms inside.
    document.addEventListener("click", function (e) {
      const revealBtn = e.target.closest(".reveal-btn");
      if (revealBtn) {
        e.stopPropagation();
        const id = revealBtn.dataset.id;
        const span = document.getElementById("pw-" + id);
        const actual = decodeURIComponent(span.dataset.actual);
        span.textContent = (span.textContent === "••••••••") ? actual : "••••••••";
        return;
      }

      const card = e.target.closest(".password-card");
      if (card && !e.target.closest("a, button, form, input")) {
        const id = card.dataset.id;
        const details = document.getElementById("details-" + id);
        if (details) details.hidden = !details.hidden;
      }
    });
  </script>
</body>
</html>
